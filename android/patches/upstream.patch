+bool RomLoader::holds_set(const GameDatabase& database, const std::string& archive_path,
+                          const std::string& name)
+{
+    const GameSpec* game = database.find(name);
+    if (game == nullptr) {
+        return false;
+    }
+    ArchiveSet archives;
+    if (!archives.open(archive_path)) {
+        return false;
+    }
+    for (const RegionSpec& region : game->regions) {
+        for (const FileSpec& file : region.files) {
+            if (region.required && archives.find(file) == nullptr) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
