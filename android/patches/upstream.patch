+// The Android build is TRI-ARCADE: the name it shows wherever the text said
+// Keisho (the About page still credits Keisho, as its licence asks).
+static std::string rebrand(std::string text)
+{
+    static constexpr std::string_view kFrom = "Keisho";
+    static constexpr std::string_view kTo   = "TRI-ARCADE";
+    for (size_t at = text.find(kFrom); at != std::string::npos; at = text.find(kFrom, at + kTo.size())) {
+        text.replace(at, kFrom.size(), kTo);
+    }
+    return text;
+}
+#endif
